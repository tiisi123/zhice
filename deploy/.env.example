# T04 (M001/S01) — 智策 staging 部署 env 模板
#
# 用法：cp .env.example .env && 编辑 .env 填入真实值 && docker compose up -d
# 本文件不含真实密钥；CI/secrets 通过 GitHub Actions secrets 注入（T05 接管）
#
# 首次部署需要先在宿主机准备 /var/log/zhice（uid 10001 = 容器内 zhice 用户）：
#   make deploy-init   # sudo mkdir /var/log/zhice && sudo chown 10001:10001 ...
# 否则 zhice-api 启动时写日志会 PermissionError 反复重启。
#
# 启动校验由 prototype/apps/api/config.py 的 @model_validator(mode="after") 把关：
#   缺 ZHICE_JWT_SECRET / ZHICE_ADMIN_PASSWORD / DATABASE_URL → RuntimeError 阻断
#   DATABASE_URL scheme 非 mysql/mysql+pymysql → RuntimeError（拒绝 sqlite 降级）
#   DEBUG=true 时降级为 warn（仅本地开发使用）
#
# 安全准则：
#   - 本文件不能含真实值（git 跟踪）；.env 文件已被 .gitignore 排除
#   - docker compose logs 不会打印 env 值，但 ps 可能泄漏，运行环境注意权限
#   - 所有 SECRET / TOKEN / PASSWORD 类 key 都不要提交到任何 git 仓库

# ─────────────────────────────────────────────────────────────────────────
# 关键：FastAPI 启动校验三件套（缺则进程 exit 1，container 反复重启）
# ─────────────────────────────────────────────────────────────────────────

# JWT 签名密钥 — 用 `openssl rand -hex 32` 生成 64 位随机十六进制
ZHICE_JWT_SECRET=

# 管理员初始密码 — 首次登录后请立即在后台修改
ZHICE_ADMIN_PASSWORD=

# 数据库连接串 — 必须 mysql+pymysql scheme；指向 zhice-db 容器（compose 内 DNS 名）
# 默认值需要在 docker-compose 网络内才能解析；MYSQL_ROOT_PASSWORD 由 docker compose
# 自动展开（注意 compose .env 文件不会替换变量内的 ${...}，需手动填具体密码）
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@zhice-db:3306/zhice

# Fernet 对称加密密钥 — 用于加密 KPL cookie 等敏感数据存储
# 生成：python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────
# MySQL 容器 root 密码（zhice-db 服务读取）
# ─────────────────────────────────────────────────────────────────────────

# 与 DATABASE_URL 中的密码必须一致；建议用 openssl rand -hex 24
MYSQL_ROOT_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────
# 部署域名 — Caddyfile 占位 {$STAGING_DOMAIN}
# ─────────────────────────────────────────────────────────────────────────

# 生产：staging.zhice.com（须先 DNS A 记录到本机公网 IP）
# 本地：':80'（走纯 HTTP，跳过 Let's Encrypt；冒号必带）
# ICP 备案：业主主域已备案；子域如未备案，部分服务商会在 80/443 拦截
STAGING_DOMAIN=:80

# ─────────────────────────────────────────────────────────────────────────
# 应用模式
# ─────────────────────────────────────────────────────────────────────────

# 生产部署设 false；本地或 staging 调试期可设 true（启动校验降级为 warn）
DEBUG=false

# 前端跨域白名单 — JSON array 字符串
CORS_ORIGINS=["https://staging.zhice.com"]

# ─────────────────────────────────────────────────────────────────────────
# 数据源 — 至少配置一个（缺失时相关接口降级或不可用）
# ─────────────────────────────────────────────────────────────────────────

# 开盘啦（KPL）— 业主在自家 KPL 账号 Web 抓包获取
KPL_USER_ID=
KPL_TOKEN=
KPL_DEVICE_ID=

# TuShare — https://tushare.pro 注册后控制台获取 token
TUSHARE_TOKEN=

# 同花顺（THS）/ 东方财富（DFCF）— Cookie 抓包获取（短期有效，需定期更新）
THS_COOKIE=
DFCF_COOKIE=

# 聚源（JYGS）
JYGS_TOKEN=
JYGS_SESSION=

# ─────────────────────────────────────────────────────────────────────────
# AI — 至少配置一个（缺失时 AI 路由返回 503 或降级提示）
# ─────────────────────────────────────────────────────────────────────────

# 首选 OpenAI-compatible API（如自建网关/聚合 API）
PREFERRED_AI_API_KEY=
PREFERRED_AI_BASE_URL=https://cc.maya.today/api/v1
PREFERRED_AI_CHAT_MODEL=gpt-5.5
PREFERRED_AI_FAST_MODEL=gpt-5.4

# Anthropic Claude（产品专用；不要使用 IDE/Agent 常用的 ANTHROPIC_API_KEY）
ZHICE_AI_ANTHROPIC_API_KEY=
ZHICE_AI_ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI（产品专用备选；不要使用 IDE/Agent 常用的 OPENAI_API_KEY）
ZHICE_AI_OPENAI_API_KEY=

# DeepSeek V4（推荐：Copilot 问答用 Pro，速报/摘要用 Flash）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash

# ─────────────────────────────────────────────────────────────────────────
# 邮件告警（可选，M002 才接入；此处占位避免 GHA secrets 重复定义）
# ─────────────────────────────────────────────────────────────────────────

# SMTP 服务器（5xx 告警邮件）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
