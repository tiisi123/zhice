# T04 (M001/S01) — Caddy 反向代理 + 自动 HTTPS
#
# 用法：
#   生产：业主 .env 设 STAGING_DOMAIN=staging.zhice.com
#         Caddy 会自动向 Let's Encrypt 申请证书并续签（默认 60 天前续签）
#   本地：业主 .env 设 STAGING_DOMAIN=:80
#         Caddy 走纯 HTTP，跳过 ACME challenge（域名未 DNS 解析时唯一可行的模式）
#
# Let's Encrypt 失败排障：
#   - DNS：要求 STAGING_DOMAIN 已 A/AAAA 解析到本机公网 IP
#   - 80/443 端口：必须从公网可达（ACME HTTP-01 challenge 走 80）
#   - ICP 备案：业主主域已备案，子域如未备案，部分服务商会拦截 80/443，
#     需在域名服务商后台为子域单独配置（详见 deploy/.env.example 注释）
#   - 失败日志：caddy stderr → /var/log/zhice/caddy.log（compose 卷挂载）

{
	# 全局选项：让 Caddy 把访问日志写到挂载卷（业主 ssh tail 排障）
	log {
		output file /var/log/zhice/caddy.log {
			roll_size 10mb
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}
}

# 主站点 — 域名/端口由 STAGING_DOMAIN 注入
{$STAGING_DOMAIN} {
	# 反代到 zhice-web（Nginx），后者再处理 SPA + /api 路由
	reverse_proxy zhice-web:80 {
		# WebSocket 升级头由 Caddy 自动透传，无需手动配置
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# 站点级访问日志
	log {
		output file /var/log/zhice/caddy-access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}

	# 安全头（HSTS 仅在 HTTPS 模式下生效，:80 模式自动跳过）
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
